{
  "name": "dept-of-physics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Department of Physics - Government Bangla College. A Bun-powered React educational portal.",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18"
  },
  "scripts": {
    "dev": "react-scripts start",
    "start": "serve -s build -l 3000",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "preview": "serve -s build -l 3000",
    "test": "bun test",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src/**/*.{js,jsx,json,scss,css}",
    "eject": "react-scripts eject",
    "postinstall": "node -e \"console.log('Bun install complete. Run bun run dev to start.')\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.17.0",
    "framer-motion": "^12.43.0",
    "p5": "^1.11.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.18.0",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.5",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "jsdom": "^26.0.0",
    "source-map": "^0.6.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhazexo/dop-repo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/minhazexo/dop-repo/issues"
  }
}
