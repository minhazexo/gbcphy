# Copy this file to .env.local and set values for your environment.
# Never commit .env.local, service-role keys, or database passwords.

# Supabase browser client (publishable/anon key only; RLS must be enabled)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional integrations
VITE_GEMINI_API_KEY=
VITE_SITE_URL=https://gbcphy.vercel.app

# Backward-compatible aliases (use VITE_* for new configuration)
# REACT_APP_SUPABASE_URL=
# REACT_APP_SUPABASE_ANON_KEY=
# REACT_APP_SITE_URL=
