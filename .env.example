# Environment Variables Template
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local or any real secrets to version control.

# ====================
# Frontend (Vite — VITE_ prefix; REACT_APP_ also works for backward compat)
# ====================

# Supabase (public anon key + project URL - safe to expose in client code)
# Obtain from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API key (used by the AI chat, lazy-loaded)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Site URL (used for canonical/redirect links)
VITE_SITE_URL=https://your-project.vercel.app

# Google Analytics (optional)
VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=https://xxxxxxxxxxxxx.ingest.sentry.io/xxxxxxx

# Legacy CRA aliases (still supported via vite envPrefix config)
# REACT_APP_SUPABASE_URL=
# REACT_APP_SUPABASE_ANON_KEY=
# REACT_APP_GEMINI_API_KEY=

# ====================
# Build / runtime
# ====================
# PORT=3000

# ====================
# Netlify / deployment (set in the hosting dashboard, not here)
# ====================
# NODE_VERSION=18
# BUN_VERSION=1.4.3
